<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lässt den Lasterzeuger des Belastungstests ohne Windows-Gerät laufen:
       Prozessor, Arbeitsspeicher und Datenträger werden zehn Sekunden lang
       belastet, danach müssen die Zähler stimmen und die Datei weg sein. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Lastprobe</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/HpDiagnose/Core/Platform/Wmi.cs" />
    <Compile Include="../../src/HpDiagnose/Core/Stress/Lasterzeuger.cs" />
    <Compile Include="Probe.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
